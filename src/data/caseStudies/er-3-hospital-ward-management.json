    { "id": "encounter", "label": "Encounter / Visit entity", "acceptedNodeTypes": ["erEntity"], "aliases": ["encounter", "visit", "consultation", "appointment"], "minMembers": 2 },
    { "id": "lab-order", "label": "LabOrder entity", "acceptedNodeTypes": ["erEntity"], "aliases": ["lab order", "laborder", "lab_order", "test order"], "minMembers": 2 },
    { "id": "lab-test", "label": "LabTest catalog entity", "acceptedNodeTypes": ["erEntity"], "aliases": ["lab test", "labtest", "lab_test", "test catalog"], "minMembers": 2 }
