      "label": "OrderItem line-item entity",
      "acceptedNodeTypes": ["erEntity"],
      "aliases": ["order item", "order_item", "orderitem", "line item", "order line"],
      "minMembers": 2
    },
    {
      "id": "product",
      "label": "Product entity",
      "acceptedNodeTypes": ["erEntity"],
      "aliases": ["product", "products", "item", "sku"],
      "minMembers": 2
