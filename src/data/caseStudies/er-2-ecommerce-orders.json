  "title": "Online Storefront & Order Fulfillment",
  "diagramType": "er",
  "difficulty": "Intermediate",
  "domain": "E-Commerce",
  "statement": "Model the relational schema for an online store. A Customer can place many Orders, and each Order contains one or more Order Items referencing a Product (storing quantity and unit_price at purchase time). Each Order has at most one Payment record tracking amount, method, and status.",
  "deliverables": [
    "Normalize line items and historical pricing into 3NF.",
    "Distinguish 1:N relationships from optional 1:1 links."
  ],
  "hints": [
    "OrderItem resolves the many-to-many relationship between Order and Product and stores unit_price.",
    "Use 1:1 Crow's Foot cardinality between Order and Payment.",
    "Ensure every entity has a Primary Key."
  ],
  "concepts": [
