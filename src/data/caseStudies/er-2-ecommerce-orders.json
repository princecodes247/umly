      "id": "customer",
      "label": "Customer entity",
      "acceptedNodeTypes": ["erEntity"],
      "aliases": ["customer", "buyer", "user", "shopper"],
      "minMembers": 2
    },
    {
      "id": "order",
      "label": "Order entity",
      "acceptedNodeTypes": ["erEntity"],
      "aliases": ["order", "orders", "purchase"],
      "minMembers": 2
    },
    {
