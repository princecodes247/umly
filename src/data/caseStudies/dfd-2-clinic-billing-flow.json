    { "id": "insurer", "label": "Insurer external entity", "acceptedNodeTypes": ["dfdExternalEntity"], "aliases": ["insurer", "insurance", "payer"] },
    { "id": "register", "label": "Register Visit process", "acceptedNodeTypes": ["dfdProcess"], "aliases": ["register", "register visit", "check in"] },
    { "id": "claim-proc", "label": "Submit Insurance Claim process", "acceptedNodeTypes": ["dfdProcess"], "aliases": ["submit claim", "insurance claim", "billing", "claim"] },
    { "id": "patients-ds", "label": "Patients data store", "acceptedNodeTypes": ["dfdDataStore"], "aliases": ["patients", "patient"] },
    { "id": "visits-ds", "label": "Visits data store", "acceptedNodeTypes": ["dfdDataStore"], "aliases": ["visits", "visit", "encounters"] },
    { "id": "claims-ds", "label": "Claims data store", "acceptedNodeTypes": ["dfdDataStore"], "aliases": ["claims", "claim"] }
  ],
  "relationships": [
