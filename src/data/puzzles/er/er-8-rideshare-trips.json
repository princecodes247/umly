      "id": "bad-driver-payment",
      "source": "ent-driver",
      "target": "ent-payment",
      "data": { "relationshipType": "er", "erSourceCardinality": "one", "erTargetCardinality": "many" }
    }
  ],
  "solutions": [
    {
      "description": "Normalized ride-sharing trip ledger",
      "edges": [
        { "source": "ent-rider", "target": "ent-trip", "type": "er", "bidirectional": true, "erSourceCardinality": "one", "erTargetCardinality": "many", "description": "Rider requests Trips" },
